# Copy to .env for local development. Never commit .env.
# On Render, set these as real environment variables in the dashboard
# (or via render.yaml's envVars with sync: false) — do NOT put real
# secrets in this file or in render.yaml itself.

# --- Database ---
# For local MySQL:
DATABASE_URL="mysql://user:password@localhost:3306/shadowfax_payout"
#
# For TiDB Cloud (Serverless tier): TiDB requires TLS. Get the exact
# connection string from TiDB Cloud's "Connect" dialog — it will look like:
#   mysql://<user>:<password>@<host>:4000/<database>?sslaccept=strict
# The `sslaccept=strict` (or `ssl-ca=/etc/ssl/cert.pem` on some platforms)
# parameter is required — without it, Prisma's connection will fail against
# TiDB Cloud. Do not strip it off when copying the string in.

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="8h"

PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
# In production, set this to your actual Vercel deployment URL(s), e.g.
# CORS_ORIGIN="https://your-app.vercel.app"
CORS_ORIGIN="http://localhost:3000"
