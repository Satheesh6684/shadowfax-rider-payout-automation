// Shadowfax Amazon Rider Payout Arrears Management System
// Prisma schema — Phase 0 foundation
//
// Design principles (SRS §15.2):
// - Normalized tables, foreign keys, indexes
// - Nothing here is ever overwritten across weeks — every weekly entity carries
//   a weekStartDate and, where edits happen, a version number + history table
// - Payout formulas are NOT modeled here — RiderCalculation stores results only

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- Authentication (SRS §6) ----------
// Phase 1 = single admin login. `role` is a plain string now so multi-role
// RBAC (Admin / Operations Manager / Read Only) can be added later without
// a schema break — see Phase 8.
model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  passwordHash        String
  name                String
  role                String     @default("ADMIN") // ADMIN | MANAGER | OPERATIONS | VIEWER
  isActive            Boolean    @default(true)
  mustChangePassword  Boolean    @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  auditLogs           AuditLog[]
  loginHistory        LoginHistory[]

  @@map("users")
}

model LoginHistory {
  id         String   @id @default(uuid())
  userId     String?
  email      String
  success    Boolean
  reason     String? // populated on failure, e.g. "Incorrect password"
  ipAddress  String?
  userAgent  String?
  occurredAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([email])
  @@map("login_history")
}

// ---------- Master data ----------
model City {
  id     String  @id @default(uuid())
  name   String  @unique
  stores Store[]

  @@map("cities")
}

model Store {
  id         String   @id @default(uuid())
  storeCode  String   @unique
  storeName  String
  cityId     String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  city               City                 @relation(fields: [cityId], references: [id])
  rateCards          WeeklyRateCard[]
  uploadedOrders     UploadedOrder[]
  uploadedLoginHours UploadedLoginHours[]

  @@index([cityId])
  @@map("stores")
}

model RiderMaster {
  id           String   @id @default(uuid())
  riderId      String   @unique
  riderName    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  calculations RiderCalculation[]
  history      RiderHistory[]

  @@map("rider_master")
}

// ---------- Module 1: Rate Card Management (SRS §12–13) ----------
// One LIVE row per store, per week — this is the current state. Every edit
// snapshots the pre-edit values into RateCardHistory and bumps `version` in
// place, rather than multiplying rows; `status` governs whether the row (and
// therefore its whole week, once every row is locked together) can still be
// edited. Nothing here is ever hard-deleted — see RateCardStatus.DELETED.
model WeeklyRateCard {
  id              String   @id @default(uuid())
  weekStartDate   DateTime
  weekEndDate     DateTime
  storeId         String
  rcType          String
  mgType          String
  minimumOrders   Int
  maximumOrders   Int
  mgAmount        Decimal  @db.Decimal(10, 2)
  variablePay     Decimal  @db.Decimal(10, 2)
  weeklyIncentive Decimal? @db.Decimal(10, 2)
  orderIncentive  Decimal? @db.Decimal(10, 2)
  status          String   @default("ACTIVE") // ACTIVE | LOCKED | DELETED
  version         Int      @default(1)
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // ---- Calculation Engine business-rule fields (additive; every field
  // above this line is untouched from the original Rate Card module) ----
  //
  // Minimum Login Hours gates MG eligibility. Deliberately nullable with NO
  // hardcoded default anywhere in application code (not even the commonly-
  // cited 8.5h) — a rate card that hasn't configured this makes MG report a
  // clear exception instead of silently assuming a number.
  minimumLoginHours Decimal? @db.Decimal(4, 2)

  // MG and Variable slabs, exactly as named in the business rules (O1-O7 /
  // MG1-MG7 / Var1-Var7). A store may configure as few as one slab (o1/mg1
  // or o1/var1 only) or all seven — the calculation engine determines which
  // are populated at read time rather than assuming any fixed count.
  o1  Int?
  o2  Int?
  o3  Int?
  o4  Int?
  o5  Int?
  o6  Int?
  o7  Int?
  mg1 Decimal? @db.Decimal(10, 2)
  mg2 Decimal? @db.Decimal(10, 2)
  mg3 Decimal? @db.Decimal(10, 2)
  mg4 Decimal? @db.Decimal(10, 2)
  mg5 Decimal? @db.Decimal(10, 2)
  mg6 Decimal? @db.Decimal(10, 2)
  mg7 Decimal? @db.Decimal(10, 2)
  var1 Decimal? @db.Decimal(10, 2)
  var2 Decimal? @db.Decimal(10, 2)
  var3 Decimal? @db.Decimal(10, 2)
  var4 Decimal? @db.Decimal(10, 2)
  var5 Decimal? @db.Decimal(10, 2)
  var6 Decimal? @db.Decimal(10, 2)
  var7 Decimal? @db.Decimal(10, 2)

  // Generic weekly-pay-type config for the F+V family (F+V, F+V1, F+V2,
  // F+V3, and any future variant) — keyed by strategy name so a new
  // payment type is addable by configuring a new key here plus one new
  // strategy class, with NO schema migration, per the business rules'
  // explicit extensibility requirement (Architecture Requirements §8).
  // Shape: { "FV": { "variableRate": 50, "bonusSlabs": [{ "minOrders": 90, "amount": 4800 }] }, "FV1": {...} }
  weeklyPayConfig Json?

  store             Store              @relation(fields: [storeId], references: [id])
  specialIncentives SpecialIncentive[]
  history           RateCardHistory[]

  @@unique([storeId, weekStartDate])
  @@index([weekStartDate, weekEndDate])
  @@index([status])
  @@map("weekly_rate_cards")
}

// Append-only. Never edited or deleted (SRS §13.12: "Historical versions cannot be edited").
model RateCardHistory {
  id            String   @id @default(uuid())
  rateCardId    String
  version       Int
  changeSummary String
  changedBy     String
  changedAt     DateTime @default(now())
  snapshot      Json // full row snapshot at this version, for exact historical replay

  rateCard WeeklyRateCard @relation(fields: [rateCardId], references: [id])

  @@index([rateCardId])
  @@map("rate_card_history")
}

model SpecialIncentive {
  id            String   @id @default(uuid())
  rateCardId    String
  weekStartDate DateTime
  name          String
  description   String?  @db.Text
  amount        Decimal  @db.Decimal(10, 2)
  eligibility   String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rateCard WeeklyRateCard @relation(fields: [rateCardId], references: [id])

  @@index([weekStartDate])
  @@map("special_incentives")
}

// ---------- Module 2: Payment Configuration (SRS §14) ----------
// This is the ORIGINAL SRS's concept: payment categories auto-detected from
// a weekly Valinor upload, toggled include/exclude per week. Left untouched —
// no repository/service/controller exists for it yet. It'll likely get wired
// up once Upload Center's Valinor upload is built.
model PaymentConfiguration {
  id            String   @id @default(uuid())
  weekStartDate DateTime
  weekEndDate   DateTime
  paymentType   String // auto-detected from uploaded Valinor data — never hardcoded
  isIncluded    Boolean  @default(false)
  detectedFrom  String? // originating upload file name
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([weekStartDate, paymentType])
  @@map("payment_configuration")
}

// ---------- Payment Type master registry (this implementation phase) ----------
// A manually-curated catalogue of payment types the Calculation Engine will
// reference later (Order Incentive, Weekly Incentive, Manual Incentive,
// Special Incentive, Recovery, Penalty). Same versioned-edit + soft-delete
// pattern as WeeklyRateCard, for consistency.
model PaymentType {
  id                String   @id @default(uuid())
  name              String   @unique
  category          String // ORDER_INCENTIVE | WEEKLY_INCENTIVE | MANUAL_INCENTIVE | SPECIAL_INCENTIVE | RECOVERY | PENALTY
  calculationMethod String // FIXED_AMOUNT | PERCENTAGE | FORMULA_BASED
  priority          Int      @default(0)
  status            String   @default("ACTIVE") // ACTIVE | INACTIVE | DELETED
  description       String?  @db.Text
  version           Int      @default(1)
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  history PaymentTypeHistory[]

  @@index([category])
  @@index([status])
  @@map("payment_types")
}

model PaymentTypeHistory {
  id            String   @id @default(uuid())
  paymentTypeId String
  version       Int
  changeSummary String
  changedBy     String
  changedAt     DateTime @default(now())
  snapshot      Json

  paymentType PaymentType @relation(fields: [paymentTypeId], references: [id])

  @@index([paymentTypeId])
  @@map("payment_type_history")
}

// ---------- Module 3: Upload Center (SRS §24) ----------
// One row per uploaded file, regardless of type. Individual data rows land in
// the four tables below; this is the audit/history trail for the upload itself.
model UploadBatch {
  id               String    @id @default(uuid())
  uploadType       String // ORDERS | LOGIN_HOURS | RATE_CARD | VALINOR
  fileName         String
  weekStartDate    DateTime
  totalRecords     Int
  status           String // PROCESSING | SUCCESS | FAILED | REPLACED | REMOVED
  validationStatus String    @default("PENDING") // PENDING | PASSED | WARNING | FAILED — set by the Validation Engine, not this module
  errorMessage     String?   @db.Text
  uploadedBy       String
  uploadedAt       DateTime  @default(now())
  replacesId       String? // points at the UploadBatch this one replaced, if any

  @@index([weekStartDate, uploadType])
  @@map("upload_batches")
}

model UploadedOrder {
  id            String   @id @default(uuid())
  weekStartDate DateTime
  date          DateTime
  orderId       String
  awbNumber     String?
  riderId       String
  riderName     String?
  storeId       String?
  storeCode     String
  city          String?
  status        String
  uploadBatchId String
  createdAt     DateTime @default(now())

  store Store? @relation(fields: [storeId], references: [id])

  @@unique([orderId, weekStartDate])
  @@index([weekStartDate, riderId])
  @@index([uploadBatchId])
  @@map("uploaded_orders")
}

model UploadedLoginHours {
  id            String   @id @default(uuid())
  weekStartDate DateTime
  date          DateTime
  riderId       String
  riderName     String?
  storeId       String?
  storeCode     String?
  loginHours    Decimal  @db.Decimal(5, 2)
  uploadBatchId String
  createdAt     DateTime @default(now())

  store Store? @relation(fields: [storeId], references: [id])

  @@unique([riderId, date])
  @@index([weekStartDate, riderId])
  @@index([uploadBatchId])
  @@map("uploaded_login_hours")
}

model UploadedPayment {
  id            String   @id @default(uuid())
  weekStartDate DateTime
  date          DateTime
  riderId       String
  paymentType   String
  amount        Decimal  @db.Decimal(10, 2)
  considered    String? // raw value from the "Considered" column — interpreted by the Validation Engine, not here
  uploadBatchId String
  createdAt     DateTime @default(now())

  @@index([weekStartDate, riderId, paymentType])
  @@index([uploadBatchId])
  @@map("uploaded_payments")
}

// Staging table for bulk Rate Card upload — deliberately separate from the
// live WeeklyRateCard table. Nothing here ever touches WeeklyRateCard
// directly; that import step belongs to the Validation Engine / a later
// "commit" action, once rows have been reviewed. This keeps the Rate Card
// module's own manual-CRUD path completely untouched.
model UploadedRateCard {
  id                String   @id @default(uuid())
  weekStartDate     DateTime
  storeCode         String
  storeName         String
  city              String
  rcType            String
  mgType            String
  minimumOrders     Int
  maximumOrders     Int
  mgAmount          Decimal  @db.Decimal(10, 2)
  variablePay       Decimal  @db.Decimal(10, 2)
  weeklyIncentive   Decimal? @db.Decimal(10, 2)
  orderIncentive    Decimal? @db.Decimal(10, 2)
  uploadBatchId     String
  createdAt         DateTime @default(now())

  @@index([weekStartDate])
  @@index([uploadBatchId])
  @@map("uploaded_rate_cards")
}

// ---------- Module 4: Validation Engine ----------
// One run per "Run Validation" action for a week. Each run snapshots the
// staged upload data at that moment and produces a full list of issues —
// re-running after fixing an upload creates a NEW run rather than editing
// the old one, so there's a real history of validation attempts.
model ValidationRun {
  id            String   @id @default(uuid())
  weekStartDate DateTime
  status        String // PASSED | WARNING | FAILED
  totalErrors   Int
  totalWarnings Int
  runBy         String
  runAt         DateTime @default(now())

  issues ValidationIssue[]

  @@index([weekStartDate])
  @@map("validation_runs")
}

model ValidationIssue {
  id              String   @id @default(uuid())
  validationRunId String
  weekStartDate   DateTime
  category        String // ORDERS | LOGIN_HOURS | RATE_CARD | VALINOR — always one of the 4 upload types, even for cross-file checks (attributed to whichever side the check is "about")
  checkName       String // e.g. DUPLICATE_AWB, MISSING_STORE, NEGATIVE_MG
  severity        String // ERROR | WARNING
  message         String   @db.Text
  context         Json? // identifying info for the offending row(s) — orderId, riderId, storeCode, etc.
  createdAt       DateTime @default(now())

  run ValidationRun @relation(fields: [validationRunId], references: [id])

  @@index([validationRunId])
  @@index([weekStartDate, category])
  @@map("validation_issues")
}

// ---------- Module 5: Calculation Engine (SRS §30–31) ----------
// This table stores calculation RESULTS only. No payout formulas live in the
// schema or in application code — the governing SRS explicitly defers them
// ("Do Not Invent Payout Formulas"). The Strategy-pattern engine writes
// here; every strategy currently reports EXCEPTION until real business
// rules are supplied, rather than fabricating a number.
model RiderCalculation {
  id                  String    @id @default(uuid())
  weekStartDate       DateTime
  riderId             String
  storeId             String?
  totalEligibleAmount Decimal?  @db.Decimal(10, 2)
  actualAmount        Decimal?  @db.Decimal(10, 2)
  pendingAmount       Decimal?  @db.Decimal(10, 2)
  status              String    @default("PENDING") // PENDING | CALCULATED | EXCEPTION
  remarks             String?   @db.Text
  calculatedAt        DateTime?
  createdAt           DateTime  @default(now())

  rider RiderMaster @relation(fields: [riderId], references: [riderId])

  @@unique([riderId, weekStartDate])
  @@index([weekStartDate])
  @@map("rider_calculations")
}

// One row per "Run Calculation" action for a week — mirrors ValidationRun's
// pattern. Re-running never edits an old run; it creates a new one.
model CalculationRun {
  id              String   @id @default(uuid())
  weekStartDate   DateTime
  status          String // COMPLETED | COMPLETED_WITH_EXCEPTIONS | FAILED
  totalRiders     Int
  totalCalculated Int
  totalExceptions Int
  runBy           String
  runAt           DateTime @default(now())

  @@index([weekStartDate])
  @@map("calculation_runs")
}

// Per-rider, per-strategy trace for a calculation run — this is what "no
// massive if-else, independently extendable" strategies each report back,
// and what a future Exception Management screen will read from.
model CalculationLog {
  id               String   @id @default(uuid())
  calculationRunId String
  weekStartDate    DateTime
  riderId          String
  strategyName     String // MG | VARIABLE | FV | FV1 | FV2 | SPECIAL_INCENTIVE | VALINOR_MERGE | ROUND_OFF
  status           String // CALCULATED | SKIPPED | EXCEPTION
  amount           Decimal? @db.Decimal(10, 2)
  message          String?  @db.Text
  createdAt        DateTime @default(now())

  @@index([calculationRunId])
  @@index([weekStartDate, riderId])
  @@map("calculation_logs")
}

model RiderHistory {
  id            String   @id @default(uuid())
  riderId       String
  weekStartDate DateTime
  eventType     String
  description   String   @db.Text
  createdAt     DateTime @default(now())

  rider RiderMaster @relation(fields: [riderId], references: [riderId])

  @@index([riderId, weekStartDate])
  @@map("rider_history")
}

// ---------- Module 6: Reports (SRS §32) ----------
// Every generation creates a new row — reports are never overwritten.
model GeneratedReport {
  id            String    @id @default(uuid())
  weekStartDate DateTime
  reportType    String // WEEKLY_PAYOUT_REPORT (multi-sheet workbook) — extensible for future single-sheet variants
  format        String // XLSX | CSV | PDF
  filePath      String
  fileName      String    @default("report.xlsx")
  fileSizeBytes Int       @default(0)
  downloadCount Int       @default(0)
  lastDownloadedAt DateTime?
  generatedBy   String
  generatedAt   DateTime  @default(now())

  @@index([weekStartDate, reportType])
  @@map("generated_reports")
}

// ---------- Module 9: Exception Management ----------
// A live, resolvable ledger — distinct from ValidationIssue/CalculationLog,
// which stay exactly as they were (append-only, one row per run, never
// edited). Exceptions are upserted here whenever a Validation run produces
// an ERROR-severity issue or a Calculation run produces a per-rider
// EXCEPTION result, deduplicated so re-running the same broken week doesn't
// spawn duplicate open tickets — it just confirms the same one is still open.
model Exception {
  id              String    @id @default(uuid())
  weekStartDate   DateTime
  source          String // VALIDATION | CALCULATION
  category        String // ORDERS | LOGIN_HOURS | RATE_CARD | VALINOR | CALCULATION
  checkName       String // e.g. UNKNOWN_STORE_CODE, or a strategy name like MG
  severity        String // ERROR | WARNING
  riderId         String?
  // Non-nullable dedupe key (riderId, or "GLOBAL" when not rider-specific) —
  // MySQL unique indexes treat every NULL as distinct, which would silently
  // defeat deduplication for non-rider exceptions if riderId were used directly.
  dedupeKey       String
  message         String    @db.Text
  context         Json?
  status          String    @default("OPEN") // OPEN | RESOLVED | IGNORED
  resolvedBy      String?
  resolvedAt      DateTime?
  resolutionNotes String?   @db.Text
  sourceRunId     String // validationRunId or calculationRunId, for traceability
  occurrenceCount Int       @default(1) // bumped each time the same exception recurs on a re-run
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())

  @@unique([weekStartDate, source, category, checkName, dedupeKey])
  @@index([weekStartDate, status])
  @@index([riderId])
  @@map("exceptions")
}

// ---------- Module: Settings ----------
// Singleton row (fixed id) — one settings record for the whole application.
model AppSettings {
  id                                   String   @id @default("singleton")
  organizationName                     String   @default("Shadowfax")
  defaultCurrency                      String   @default("INR")
  defaultRoundingPrecision             Int      @default(2)
  defaultRoundingMode                  String   @default("HALF_UP") // HALF_UP | HALF_DOWN | CEILING | FLOOR
  maxUploadSizeMb                      Int      @default(20)
  allowedUploadFormats                 String   @default("csv,xlsx")
  blockCalculationOnValidationFailure  Boolean  @default(true)
  defaultReportFormat                  String   @default("XLSX")
  notifyOnUploadSuccess                Boolean  @default(true)
  notifyOnUploadFailure                Boolean  @default(true)
  notifyOnValidationComplete           Boolean  @default(true)
  notifyOnCalculationComplete          Boolean  @default(true)
  notifyOnReportGenerated              Boolean  @default(true)
  updatedBy                            String?
  updatedAt                            DateTime @updatedAt

  @@map("app_settings")
}

// ---------- Module: Notifications ----------
// Persisted notification center (the bell icon's contents) — distinct from
// Toast, which stays exactly as-is for real-time in-session feedback. This
// is what lets a user see "what happened" after the fact, not just at the
// moment it occurred.
model Notification {
  id        String    @id @default(uuid())
  type      String // SUCCESS | ERROR | INFO
  category  String // UPLOAD | VALIDATION | CALCULATION | REPORT
  title     String
  message   String    @db.Text
  isRead    Boolean   @default(false)
  userId    String? // null = broadcast to all users
  context   Json?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ---------- System-wide audit log (SRS §19) ----------
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  module     String
  action     String
  oldValue   Json?
  newValue   Json?
  occurredAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([module, occurredAt])
  @@map("audit_logs")
}
