# Copy to .env.local for local development.
# On Vercel, set this as a real Environment Variable in the project
# dashboard (Settings -> Environment Variables) — it's baked in at BUILD
# time (NEXT_PUBLIC_ prefix), so it must be set before/during the build,
# not just at runtime.

# Local development (points at the backend running on localhost:5000):
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Production: point this at your deployed Render backend URL, e.g.
# NEXT_PUBLIC_API_BASE_URL=https://shadowfax-payout-backend.onrender.com/api
